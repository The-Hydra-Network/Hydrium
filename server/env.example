# Copia questo file in ".env" (dentro la cartella server) e sostituisci i valori.
# NON usare i segreti del .env che c'era nello zip del tuo amico: genera i tuoi.

# genera con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
HYDRIUM_JWT_SECRET=INCOLLA_QUI_IL_SEGRETO

# genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HYDRIUM_TOKEN_KEY=INCOLLA_QUI_LA_CHIAVE

# PocketBase gira solo in locale, MAI esporlo nel tunnel
POCKETBASE_URL=http://127.0.0.1:8090

# Photon (dashboard.photonengine.com)
PHOTON_REALTIME_APP_ID=0e939dc2-6b82-4486-83d5-01e163d1525a
PHOTON_VOICE_APP_ID=4bec04b4-a6b5-4444-9690-4d2f823e2a74
PHOTON_CHAT_APP_ID=697a13e9-e677-4ba8-9710-1fe3db561864
PHOTON_REGION=eu

# versione del client e porta del server
GAME_VERSION=20231207
PORT=9000
