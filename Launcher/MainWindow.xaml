<Window x:Class="Hydrlauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hydrium Launcher"
        Width="1000"
        Height="680"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="MainWindow_Closing"
        Icon="Assets/HydriumIcon.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E6122035"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#E91A2D48"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4E91E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F8FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#C3D4E8"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#283B55"/>
            <Setter Property="BorderBrush" Value="#54759B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Background" Value="#283B55"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#142238"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#567BA5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            BorderThickness="1"
            BorderBrush="#9EC8F4"
            ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="Assets/HydriumBlue.png" Stretch="UniformToFill"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#5E10223B" Grid.RowSpan="3"/>

            <Border Grid.Row="0" Background="#B90E1A2B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/HydriumLogo.png"
                           Width="174"
                           Height="48"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"/>
                    <TextBlock x:Name="AccountStatusTextBlock"
                               Grid.Column="1"
                               Text="Not signed in"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="—"
                                Width="36"
                                Height="32"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="18"
                                Cursor="Hand"
                                Click="MinimizeWindow"/>
                        <Button Content="×"
                                Width="36"
                                Height="32"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="20"
                                Cursor="Hand"
                                Click="CloseWindow"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="HYDRIUM"
                               Foreground="#DAEAFE"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Launch your world"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="38"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Choose how to play, sign in to your account, and launch Hydrium."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,26"/>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#6D9FD0"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Game location"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GamePathTextBox"
                                         Text="C:\Hydrium\RecRoom.exe"
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Find Game"
                                        Click="FindGameButton_Click"/>
                            </Grid>

                            <TextBlock Text="Account"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AccountNameTextBox"
                                         IsReadOnly="True"
                                         Text="Sign in to your Hydrium account"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Log Into Account"
                                        Click="LoginButton_Click"/>
                            </Grid>

                            <TextBlock Text="Play mode"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScreenModeButton"
                                        Style="{StaticResource ModeButton}"
                                        Content="Play In Screen"
                                        Margin="0,0,6,0"
                                        Click="ScreenModeButton_Click"/>
                                <Button x:Name="VrModeButton"
                                        Grid.Column="1"
                                        Style="{StaticResource ModeButton}"
                                        Content="Play In VR"
                                        Margin="6,0,0,0"
                                        Click="VrModeButton_Click"/>
                            </Grid>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Launch Hydrium"
                                    Height="50"
                                    FontSize="18"
                                    Click="LaunchGameButton_Click"/>
                            <CheckBox x:Name="CloseLauncherCheckBox"
                                      IsChecked="True"
                                      Foreground="{StaticResource MutedBrush}"
                                      Margin="4,14,0,0">
                                <TextBlock Text="Close launcher when the game starts"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#6D9FD0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22">
                        <StackPanel>
                            <Image Source="Assets/HydriumLogo.png"
                                   Width="132"
                                   Height="42"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,18"/>
                            <TextBlock Text="Player profile"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="PlayerNameTextBlock"
                                       Text="Guest"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="PlayerRoleTextBlock"
                                       Text="Sign in to load your account"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#6D9FD0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="20"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Ready to play?"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Hydrium must be installed at C:\Hydrium\RecRoom.exe. Other game paths are not accepted."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <Button x:Name="InstallGameButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Install Game"
                                    Margin="0,16,0,0"
                                    Click="InstallGameButton_Click"/>
                            <ProgressBar x:Name="InstallerProgressBar"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"
                                         Margin="0,12,0,0"/>
                            <TextBlock x:Name="InstallerStatusTextBlock"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="0,6,0,0"/>
                            <Button x:Name="CancelInstallButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Cancel Download"
                                    Visibility="Collapsed"
                                    Margin="0,10,0,0"
                                    Click="CancelInstallButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#B90E1A2B" Padding="16,10">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           FontSize="13"/>
            </Border>
        </Grid>
    </Border>
</Window>
